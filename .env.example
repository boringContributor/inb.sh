# Copied to .env (gitignored). SST loads it automatically for `sst dev` / `sst deploy`.

# --- Cloudflare credentials (required to deploy) ---------------------------
# API token: dash.cloudflare.com → My Profile → API Tokens → Create token → "Edit Cloudflare Workers"
# template, then add: Account · D1 · Edit, Account · Queues · Edit, Account · Workers R2 Storage · Edit,
# and scope Zone resources to inb.sh (needs Zone · DNS · Edit and Zone · Workers Routes · Edit).
CLOUDFLARE_API_TOKEN=
# dash.cloudflare.com → any zone → right sidebar "Account ID"
CLOUDFLARE_DEFAULT_ACCOUNT_ID=

# --- App -------------------------------------------------------------------
# Captures on https://inb.sh/<slug>, dashboard on https://app.inb.sh.
# The zone must be on this Cloudflare account. Leave empty to use workers.dev.
INBOUND_DOMAIN=inb.sh
# public: anyone can use it — anonymous workspaces with plan limits (inb.sh).
# private: a single password-protected workspace for self-hosting.
INBOUND_MODE=public
# Shown in the sidebar "Star on GitHub" card.
INBOUND_GITHUB_REPO=boringContributor/inb.sh

# Secrets are NOT set here — use SST's encrypted secret store per stage:
#   pnpm sst secret set AdminPassword '…' --stage production
#   pnpm sst secret set SessionSecret "$(openssl rand -hex 32)" --stage production

# Single stage: every `sst` command targets production.
SST_STAGE=production
